# --- Withings developer app (https://developer.withings.com/dashboard/) ---
WITHINGS_CLIENT_ID=
WITHINGS_CLIENT_SECRET=

# Public URL where this app is reachable (no trailing slash).
# The OAuth callback registered at Withings must be: ${PUBLIC_URL}/api/withings/callback
PUBLIC_URL=http://localhost:8000

# Let Withings push "new data" notifications to ${PUBLIC_URL}/api/withings/notify
# (requires PUBLIC_URL to be reachable from the internet over HTTPS). Otherwise we poll.
WITHINGS_NOTIFY=false

# Password for the web UI. Strongly recommended as soon as the app is reachable from outside.
APP_PASSWORD=change-me

# Your time zone (defines what "a day" is)
TZ=Europe/Berlin

# Optional
SYNC_INTERVAL_MIN=30
HISTORY_DAYS=90
# SECRET_KEY=   # auto-generated into data/.secret_key if unset
